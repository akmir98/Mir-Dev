# Copy to .env for local development. On Vercel, add these in
# Project -> Settings -> Environment Variables instead (never commit .env).

# Gmail: turn on 2-Step Verification, then create an App Password at
# https://myaccount.google.com/apppasswords and use it as SMTP_PASS.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=nasrullahmir14@gmail.com
SMTP_PASS=nawzddldufcdziji

# Where messages are delivered (defaults to SMTP_USER)
TO_EMAIL=nasrullahmir14@gmail.com

# Optional: comma-separated origins allowed to call the API cross-origin.
# Not needed when the site and API are on the same Vercel domain.
ALLOWED_ORIGIN=https://mir-dev.vercel.app
